#!/usr/bin/env php
<?php

require __DIR__ . '/../vendor/autoload.php';

use Symfony\Component\Console\Application;
use TrustNode\Cli\Config\ConfigManager;
use TrustNode\Cli\Http\TrustNodeClient;
use TrustNode\Cli\Commands\ScanCommand;
use TrustNode\Cli\Commands\StatusCommand;
use TrustNode\Cli\Commands\RepositoriesCommand;
use TrustNode\Cli\Commands\FindingsCommand;
use TrustNode\Cli\Commands\ReportCommand;
use TrustNode\Cli\Commands\ComplianceCommand;
use TrustNode\Cli\Commands\FixCommand;
use TrustNode\Cli\Commands\ActivateCommand;
use TrustNode\Cli\Commands\UpdateCommand;
use TrustNode\Cli\Commands\DoctorCommand;
use TrustNode\Cli\Commands\RepairCommand;
// Keep existing auth commands just in case
use TrustNode\Cli\Commands\LoginCommand;
use TrustNode\Cli\Commands\LogoutCommand;
use TrustNode\Cli\Commands\WhoamiCommand;

$application = new Application('TrustNode CLI', '1.0.0');

$configManager = new ConfigManager();
$client = new TrustNodeClient($configManager);

// Register commands
$application->add(new ScanCommand($client));
$application->add(new StatusCommand($client));
$application->add(new RepositoriesCommand($client));
$application->add(new FindingsCommand($client));
$application->add(new ReportCommand($client));
$application->add(new ComplianceCommand());
$application->add(new FixCommand($client));
$application->add(new ActivateCommand($client));
$application->add(new UpdateCommand());
$application->add(new DoctorCommand($client, $configManager));
$application->add(new RepairCommand($configManager));

// Auth commands
$application->add(new LoginCommand($client, $configManager));
$application->add(new LogoutCommand($client, $configManager));
$application->add(new WhoamiCommand($client));

$application->run();
